{
  "name": "lethub-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev -H 0.0.0.0 -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:repo": "node scripts/validate-repository.mjs",
    "check:migrations": "node scripts/validate-migrations.mjs",
    "check:ci": "npm run check:repo && npm run check:migrations && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@react-google-maps/api": "^2.19.3",
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "0.539.0",
    "next": "15.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.0.0",
    "recharts": "^3.0.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.0.0",
    "eslint-config-next": "15.3.2",
    "postcss": "^8.5.5",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  }
}
